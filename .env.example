# ========================================
# COADMO Configuration File
# ========================================
# 1. Copy this file to .env (in the same directory)
# 2. Fill in your actual values
# 3. NEVER commit .env to git (it's in .gitignore)
# ========================================

# ========================================
# DJANGO CONFIGURATION
# ========================================
# Generate a new secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (use * for development only)
# Example: localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=*

# ========================================
# LDAP / ACTIVE DIRECTORY CONFIGURATION
# ========================================
# LDAP Server URI (use ldap:// or ldaps:// for SSL)
# Example: ldap://192.168.1.10 or ldap://dc.yourdomain.local
LDAP_HOST=ldap://your-ad-server-ip-or-hostname

# LDAP Bind DN (account used to connect to LDAP)
# Example: CN=admin,CN=Users,DC=yourdomain,DC=local
LDAP_BIND_DN=CN=your-admin-user,CN=Users,DC=yourdomain,DC=local

# LDAP Bind Password
LDAP_PASSWORD=your-ldap-admin-password

# LDAP Admin username (for WMI connections to remote hosts)
# This can be just the username without the full DN
# Example: administrator or admin
LDAP_ADMIN=administrator

# Domain base DN
# Example: DC=yourdomain,DC=local
DOMAIN=DC=yourdomain,DC=local

# ========================================
# SQL SERVER CONFIGURATION
# ========================================
# SQL Server host (IP or hostname)
# Example: 192.168.1.150 or sqlserver.yourdomain.local
DB_HOST=your-sql-server-ip-or-hostname

# SQL Server database name
DB_NAME=Sistemas

# SQL Server username
DB_USER=your-sql-username

# SQL Server password
DB_PASSWORD=your-sql-password

# SQL Server port (default is 1433)
DB_PORT=1433

# ========================================
# ADDITIONAL NOTES
# ========================================
# - Make sure ODBC Driver 17 for SQL Server is installed
# - LDAP_ADMIN user must have WMI access to remote computers
# - The application must run on a Windows machine for WMI functionality
# - Frontend runs on port 3000 by default
# - Backend runs on port 8000 by default
# ========================================
